# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Groq = online brain. Free to generate a key at console.groq.com/keys
GROQ_API_KEY=gsk_...

# Ollama = offline brain. No key needed (runs locally). Just have it installed.

# Added later as capabilities come online:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_NUMBER=
